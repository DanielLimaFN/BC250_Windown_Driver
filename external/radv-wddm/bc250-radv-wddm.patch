+/*
+ * =========================================================================
+ * BC-250: DESPEJO DO IB GRAFICO, PARA ANALISE OFFLINE. OPT-IN POR AMBIENTE.
+ * =========================================================================
+ * Motivo (19/09/2026): na Corrida 34 o CP_RB0 parou dentro de um IB de
+ * 1008 DW e nao haviamos guardado UM dword dele. O miniport confirmou que o
+ * fluxo era linear e bem formado (264 pacotes, zero CHAIN), mas "bem formado"
+ * nao diz QUAL pacote travou -- e o diagnostico publicado saiu com tres
+ * hipoteses e nenhuma medicao que as separasse.
+ *
+ * Com o despejo, a proxima corrida produz o stream exato, e ele se cruza com
+ * a sonda [TDR_GFX_PACKET] do KMD, que nomeia o opcode em que o ME parou.
+ * O decodificador vive no outro repositorio (tools/decode-gfx-ib.py), de
+ * proposito: assim a logica de decodificacao e testavel offline e nao depende
+ * de reconstruir o Mesa.
+ *
+ * FAIL-CLOSED: sem a variavel BC250_RADV_IB_DUMP nada acontece, nenhum
+ * arquivo e' aberto e o caminho de submissao fica byte a byte o mesmo. O teto
+ * de arquivos existe para o despejo nao encher o disco numa corrida longa.
+ */
+#define BC250_IB_DUMP_MAX_FILES 128u
+
+struct bc250_ib_dump_record {
+   char path[512];
+   uint64_t hash;
+   uint64_t va;
+   unsigned cdw;
+   bool valid;
+};
+
+static void
+bc250_dump_ib(const uint32_t *dwords, unsigned cdw, uint64_t va,
+              D3DKMT_HANDLE context_h, unsigned hw_ip,
+              struct bc250_ib_dump_record *record)
+{
+   static uint32_t s_dumped = 0;
+   const char *dir = bc250_diag_dir();
+   char path[512];
+   HANDLE file;
+   DWORD written = 0;
+   int path_chars;
+   uint64_t hash = UINT64_C(0xCBF29CE484222325);
+   const uint8_t *bytes = (const uint8_t *)dwords;
+   const DWORD byte_count = cdw * (DWORD)sizeof(uint32_t);
+
+   if (record != NULL)
+      memset(record, 0, sizeof(*record));
+
+   if (dir[0] == '\0')
+      return;
+   if (dwords == NULL || cdw == 0)
+      return;
+   if (s_dumped >= BC250_IB_DUMP_MAX_FILES) {
+      if (s_dumped == BC250_IB_DUMP_MAX_FILES) {
+         s_dumped++;
+         fprintf(stderr, "radv/wddm2: BC-250 IB_DUMP: teto de %u arquivos atingido; "
+                         "despejos posteriores NAO foram gravados\n",
+                 BC250_IB_DUMP_MAX_FILES);
+         fflush(stderr);
+      }
+      return;
+   }
+
+   /* PID e tick distinguem processos/restarts; CREATE_NEW impede sobrescrita
+    * mesmo se o contador local e o PID forem reutilizados. O hash e' dos bytes
+    * preparados para submit, antes de a GPU ter qualquer chance de le-los. */
+   for (DWORD i = 0; i < byte_count; ++i) {
+      hash ^= bytes[i];
+      hash *= UINT64_C(0x100000001B3);
+   }
+   path_chars = snprintf(path, sizeof(path), "%s\\bc250_ib_pid%lu_t%llu_%03u_va%016llx_dw%u.bin",
+            dir, (unsigned long)GetCurrentProcessId(),
+            (unsigned long long)GetTickCount64(), s_dumped,
+            (unsigned long long)va, cdw);
+   if (path_chars < 0 || (size_t)path_chars >= sizeof(path)) {
+      fprintf(stderr, "radv/wddm2: BC-250 IB_DUMP RECUSADO: caminho longo demais\n");
+      fflush(stderr);
+      return;
+   }
+   file = CreateFileA(path, GENERIC_WRITE, 0, NULL, CREATE_NEW,
+                      FILE_ATTRIBUTE_NORMAL, NULL);
+   if (file == INVALID_HANDLE_VALUE) {
+      fprintf(stderr, "radv/wddm2: BC-250 IB_DUMP RECUSADO: nao criou %s erro=%lu\n",
+              path, (unsigned long)GetLastError());
+      fflush(stderr);
+      return;
+   }
+   if (!WriteFile(file, dwords, byte_count, &written, NULL) || written != byte_count) {
+      fprintf(stderr, "radv/wddm2: BC-250 IB_DUMP INCOMPLETO: %s\n", path);
+   } else {
+      if (record != NULL) {
+         memcpy(record->path, path, (size_t)path_chars + 1u);
+         record->hash = hash;
+         record->va = va;
+         record->cdw = cdw;
+         record->valid = true;
+      }
+      fprintf(stderr, "radv/wddm2: BC-250 IB_DUMP #%u PREPARADO: %s "
+                      "PID=%lu Ctx=0x%llx Ip=%u VA=0x%llx DW=%u Fnv64=%016llx "
+                      "-- arquivo antes do submit, nao prova aceite nem execucao\n",
+              s_dumped, path, (unsigned long)GetCurrentProcessId(),
+              (unsigned long long)context_h, hw_ip,
+              (unsigned long long)va, cdw, (unsigned long long)hash);
+   }
+   fflush(stderr);
+   CloseHandle(file);
+   s_dumped++;
+}
+
+/* O stderr do dwm.exe pode nao chegar ao coletor. O .meta acompanha o .bin e
