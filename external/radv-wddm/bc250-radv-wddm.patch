+static void
+vk_d3dkmt_enumerate_adapters(vk_dxgi_adapter_cb func, void *user_data)
+{
+   HMODULE gdi = LoadLibraryA("gdi32.dll");
+   if (!gdi) return;
+
+   typedef struct _D3DKMT_ADAPTERINFO {
+      UINT  hAdapter;
+      LUID  AdapterLuid;
+      ULONG NumOfSources;
+      BOOL  bIsCurrentOwner;
+   } D3DKMT_ADAPTERINFO;
+
+   typedef struct _D3DKMT_ENUMADAPTERS2 {
+      ULONG              NumAdapters;
+      D3DKMT_ADAPTERINFO *pAdapters;
+   } D3DKMT_ENUMADAPTERS2;
+
+   typedef LONG (APIENTRY *PFN_D3DKMTEnumAdapters2)(D3DKMT_ENUMADAPTERS2*);
+   typedef LONG (APIENTRY *PFN_D3DKMTCloseAdapter)(const void*);
+
+   PFN_D3DKMTEnumAdapters2 pfnEnumAdapters2 = (PFN_D3DKMTEnumAdapters2)GetProcAddress(gdi, "D3DKMTEnumAdapters2");
+   PFN_D3DKMTCloseAdapter pfnCloseAdapter = (PFN_D3DKMTCloseAdapter)GetProcAddress(gdi, "D3DKMTCloseAdapter");
+
+   if (!pfnEnumAdapters2) return;
+
+   D3DKMT_ENUMADAPTERS2 enumInfo = {0};
+   pfnEnumAdapters2(&enumInfo);
+
+   if (enumInfo.NumAdapters == 0)
+      return;
+
+   enumInfo.pAdapters = (D3DKMT_ADAPTERINFO*)malloc(enumInfo.NumAdapters * sizeof(D3DKMT_ADAPTERINFO));
+   if (!enumInfo.pAdapters) return;
+
+   if (pfnEnumAdapters2(&enumInfo) == 0) {
+      for (ULONG i = 0; i < enumInfo.NumAdapters; i++) {
+         /* Skip null/dummy LUIDs */
+         if (enumInfo.pAdapters[i].AdapterLuid.LowPart == 0 && enumInfo.pAdapters[i].AdapterLuid.HighPart == 0)
+            continue;
+
+         struct vk_dx_adapter_info info = {};
+         info.physical_adapter_index = i;
+         info.adapter_luid = enumInfo.pAdapters[i].AdapterLuid;
+         info.vendor_id = 0x1002; /* AMD */
+         info.device_id = 0x13FE; /* AMD BC-250 */
+         info.dedicated_video_memory = 16ULL * 1024 * 1024 * 1024;
+         strcpy_s(info.description, sizeof(info.description), "AMD BC-250 (Cyan Skillfish / Navi12 Lite)");
+
+         func(&info, NULL, user_data);
+
+         if (pfnCloseAdapter) {
+            struct { UINT hAdapter; } ca = { enumInfo.pAdapters[i].hAdapter };
+            pfnCloseAdapter(&ca);
+         }
+      }
+   }
+   free(enumInfo.pAdapters);
+}
