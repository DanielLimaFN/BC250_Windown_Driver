    }
 
    _mesa_set_add(cs->buffers, radv_wddm2_bo(cs->base.ib_buffer));
+   cs->bc250_serial = (uint64_t)InterlockedIncrement64(&s_bc250_cs_serial);
 
    return &cs->base.base;
 }
 
+/* DX.42: finalize comum, depois hash dos bytes que a CPU acabou de escrever.
+ * So' CS pequenos (o preambulo BC-250 tem 180 DW): ler memoria WC custa, e o
+ * CS principal e' reescrito a cada submit. A janela exclui os 4 DW de encadeamento,
+ * igual ao copy_base da concatenacao, para os dois hashes serem comparaveis. */
+static VkResult
+radv_wddm2_cs_finalize(struct ac_cmdbuf *_cs)
+{
+   struct radv_wddm2_cs *cs = radv_wddm2_cs(_cs);
+   VkResult result = radv_winsys_cs_finalize(_cs);
+   unsigned cdw = _cs->cdw;
+
+   if (cs->base.chain_ib && cdw >= 4)
+      cdw -= 4;
+   cs->bc250_fin_count++;
+   cs->bc250_fin_cdw = cdw;
+   cs->bc250_fin_hashed = false;
+   if (_cs->buf && cdw <= BC250_CS_FIN_HASH_MAX_DW) {
+      cs->bc250_fin_fnv = bc250_fnv64_dwords(_cs->buf, cdw);
+      cs->bc250_fin_zero_prefix = bc250_zero_prefix_dwords(_cs->buf, cdw);
+      cs->bc250_fin_hashed = true;
+   }
+   return result;
+}
