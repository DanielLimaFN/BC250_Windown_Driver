+/*
+ * DX.42 -- identidade do CS. Na Corrida 84 os dois IBs com prefixo zero
+ * tinham EXATAMENTE os 180 DW do preambulo zerados e o CS principal intacto
+ * na mesma pagina do slot: a origem (cs->buf do preambulo) leu zero. Para
+ * separar "preambulo regenerado e nascido zero" de "mesmo BO que perdeu o
+ * conteudo", cada CS ganha serial unico e o hash dos bytes no finalize.
+ * Somente medicao; nenhum byte submetido muda.
+ */
 struct radv_wddm2_cs {
    struct radv_winsys_cs base;
    struct set *buffers;
+   uint64_t bc250_serial;
+   uint64_t bc250_fin_fnv;
+   unsigned bc250_fin_cdw;
+   unsigned bc250_fin_zero_prefix;
+   unsigned bc250_fin_count;
+   unsigned bc250_reset_count;
+   unsigned bc250_concat_uses;
+   bool bc250_fin_hashed;
 };
 
+#define BC250_CS_FIN_HASH_MAX_DW 512u
+
+static volatile LONG64 s_bc250_cs_serial = 0;
+
+/* Mesmo FNV-1a de 64 bits por byte do dump de IB (base 0xCBF29CE484222325). */
+static uint64_t
+bc250_fnv64_dwords(const uint32_t *dw, unsigned count)
+{
+   const uint8_t *bytes = (const uint8_t *)dw;
+   uint64_t hash = UINT64_C(0xCBF29CE484222325);
+   for (size_t i = 0; i < (size_t)count * sizeof(uint32_t); ++i) {
+      hash ^= bytes[i];
+      hash *= UINT64_C(0x100000001B3);
+   }
+   return hash;
+}
+
+static unsigned
+bc250_zero_prefix_dwords(const uint32_t *dw, unsigned count)
+{
+   unsigned n = 0;
+   while (n < count && dw[n] == 0)
+      n++;
+   return n;
+}
