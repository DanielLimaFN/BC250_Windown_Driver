+
+/* DX.40: arquivo de fluxo por processo no mesmo staging opt-in dos IBs.
+ * O stderr do DWM nao e' uma fonte arquivavel confiavel. Cada linha tem PID,
+ * submit_id e fase; o limite impede crescimento sem fim numa sessao longa. */
+static char s_bc250_diag_dir[512];
+static INIT_ONCE s_bc250_diag_dir_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK
+bc250_diag_resolve_dir(PINIT_ONCE once, PVOID parameter, PVOID *context)
+{
+   char *dir = s_bc250_diag_dir;
+   (void)once;
+   (void)parameter;
+   (void)context;
+   {
+      const char *env = getenv("BC250_RADV_IB_DUMP");
+      if (env && env[0]) {
+         strncpy(dir, env, sizeof(s_bc250_diag_dir) - 1);
+         dir[sizeof(s_bc250_diag_dir) - 1] = '\0';
+      } else {
+         HKEY key;
+         if (RegOpenKeyExA(HKEY_LOCAL_MACHINE, "SOFTWARE\\BC250\\Umd", 0,
+                           KEY_QUERY_VALUE, &key) == ERROR_SUCCESS) {
+            DWORD type = 0;
+            DWORD cb = (DWORD)(sizeof(s_bc250_diag_dir) - 1);
+            if (RegQueryValueExA(key, "GfxIbDumpDir", NULL, &type,
+                                 (LPBYTE)dir, &cb) != ERROR_SUCCESS || type != REG_SZ)
+               dir[0] = '\0';
+            else
+               dir[cb < sizeof(s_bc250_diag_dir) ? cb : sizeof(s_bc250_diag_dir) - 1] = '\0';
+            RegCloseKey(key);
+         }
+      }
+   }
+   return TRUE;
+}
+
+static const char *
+bc250_diag_dir(void)
+{
+   InitOnceExecuteOnce(&s_bc250_diag_dir_once, bc250_diag_resolve_dir, NULL, NULL);
+   return s_bc250_diag_dir;
+}
+
+static void
+bc250_diag_printf(const char *fmt, ...)
+{
+   static volatile LONG bytes_written = 0;
+   static volatile LONG cap_logged = 0;
+   char path[512];
+   char line[1024];
+   const char *dir = bc250_diag_dir();
+   FILETIME created, exited, kernel, user;
+   va_list args;
+   int len;
+   HANDLE file;
+   DWORD written;
+
+   va_start(args, fmt);
+   len = vsnprintf(line, sizeof(line), fmt, args);
+   va_end(args);
+   if (len < 0 || (size_t)len >= sizeof(line)) {
+      fprintf(stderr, "BC250_DIAG schema=1 level=ERROR event=RADV_TRACE_FORMAT\n");
+      return;
+   }
+   fputs(line, stderr);
+   if (!dir[0])
+      return;
+   if (InterlockedCompareExchange(&bytes_written, 0, 0) >= 4 * 1024 * 1024) {
+      if (InterlockedCompareExchange(&cap_logged, 1, 0) == 0)
+         fprintf(stderr, "BC250_DIAG schema=1 level=ERROR event=RADV_TRACE_CAP bytes=4194304\n");
+      return;
+   }
+   if (!GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user))
+      return;
+   int n = snprintf(path, sizeof(path), "%s\\bc250_flow_pid%lu_start%08lx%08lx.log", dir,
+                    (unsigned long)GetCurrentProcessId(),
+                    (unsigned long)created.dwHighDateTime, (unsigned long)created.dwLowDateTime);
+   if (n < 0 || (size_t)n >= sizeof(path))
+      return;
+   file = CreateFileA(path, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                      NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+   if (file == INVALID_HANDLE_VALUE) {
+      fprintf(stderr, "BC250_DIAG schema=1 level=ERROR event=RADV_TRACE_OPEN error=%lu\n",
+              (unsigned long)GetLastError());
+      return;
+   }
+   written = 0;
+   if (!WriteFile(file, line, (DWORD)len, &written, NULL) || written != (DWORD)len)
+      fprintf(stderr, "BC250_DIAG schema=1 level=ERROR event=RADV_TRACE_WRITE path=%s\n", path);
+   InterlockedExchangeAdd(&bytes_written, (LONG)written);
+   CloseHandle(file);
+}
 
