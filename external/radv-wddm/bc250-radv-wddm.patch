+/*
+ * ---------------------------------------------------------------------------
+ * BC-250, faixa DX.22 -- pool de BOs para o IB concatenado.
+ *
+ * MEDIDO na Corrida 67 (22/09, gfx-ib-dump, 32 arquivos): todo IB saia da
+ * MESMA VA 0x244f24000 -- o BO do CS do preambulo -- crescendo 392 DW por
+ * submissao, com o IB n tendo prefixo byte a byte igual ao IB n-1 (576, 976,
+ * 1368 ... 6664 DW). O ramo "UNIFICADO" copiava o CS principal para dentro do
+ * preambulo e gravava cur_offset no cdw do preambulo sem nunca restaurar: a
+ * submissao seguinte partia do fim da anterior e a GPU reexecutava TODOS os
+ * draws antigos, com descriptor sets e shaders ja liberados pela aplicacao.
+ * E' a origem medida do Cid=10 (SQC data) em VA>>8, do Cid=9 (SQC inst) em
+ * 0x200040000 e do tempo de IB crescendo ate o TDR.
+ *
+ * Regra agora: o preambulo e os CS da aplicacao NAO sao escritos. O IB unico
+ * e' montado num BO do pool; o slot fica preso ate uma fence sinalizada DEPOIS
+ * da submissao dele retirar (a fila e' em ordem, entao qualquer fence posterior
+ * cobre as anteriores). Sem fence conhecida e sem slot livre, RECUSA com log:
+ * reescrever um IB que a GPU ainda pode estar lendo e' pior que falhar.
+ * ---------------------------------------------------------------------------
+ */
+static bool
+radv_wddm2_bc250_fence_retired(const struct vk_wddm2_fence *fence)
+{
+   return fence->handle && fence->value_map &&
+          p_atomic_read(fence->value_map) >= fence->wait_value;
+}
+
+static void
+radv_wddm2_bc250_concat_slot_free_bo(struct radv_wddm2_winsys *ws,
+                                     struct radv_wddm2_bc250_concat_slot *slot)
+{
+   if (slot->bo)
+      ws->base.buffer_destroy(&ws->base, slot->bo);
+   slot->bo = NULL;
+   slot->map = NULL;
+   slot->size_dw = 0;
+}
+
+static struct radv_wddm2_bc250_concat_slot *
+radv_wddm2_bc250_concat_acquire(struct radv_wddm2_ctx *ctx, enum amd_ip_type ip, uint32_t need_dw)
+{
+   struct radv_wddm2_winsys *ws = ctx->ws;
+   struct radv_wddm2_bc250_concat_slot *slots = ctx->per_ip[ip].concat;
+   uint32_t *count = &ctx->per_ip[ip].concat_count;
+   struct radv_wddm2_bc250_concat_slot *slot = NULL;
+
+   /* 1. Recolhe os slots cuja submissao ja retirou. */
+   for (uint32_t i = 0; i < *count; i++) {
+      if (slots[i].seq && slots[i].fence_known && radv_wddm2_bc250_fence_retired(&slots[i].fence)) {
+         slots[i].seq = 0;
+         slots[i].fence_known = false;
+      }
+   }
+
+   /* 2. Livre que ja comporta. */
+   for (uint32_t i = 0; i < *count; i++) {
+      if (!slots[i].seq && slots[i].bo && slots[i].size_dw >= need_dw)
+         return &slots[i];
+   }
+
+   /* 3. Livre pequeno (sera realocado) ou slot novo. */
+   for (uint32_t i = 0; i < *count && !slot; i++) {
+      if (!slots[i].seq)
+         slot = &slots[i];
+   }
+   if (!slot && *count < RADV_WDDM2_BC250_CONCAT_SLOTS)
+      slot = &slots[(*count)++];
+
+   /* 4. Todos presos: espera o mais antigo com fence conhecida. */
+   if (!slot) {
+      struct radv_wddm2_bc250_concat_slot *oldest = NULL;
+      for (uint32_t i = 0; i < *count; i++) {
+         if (slots[i].fence_known && (!oldest || slots[i].seq < oldest->seq))
+            oldest = &slots[i];
+      }
+      if (!oldest) {
+         fprintf(stderr, "radv/wddm2: BC-250 CONCAT RECUSA: %u slots presos e NENHUM com fence "
+                         "sinalizada depois da submissao -- nao ha como provar que a GPU terminou "
+                         "de ler; o IB NAO sera reescrito\n", *count);
+         return NULL;
+      }
+      if (!vk_wddm2_fence_wait(ws->device_h, &oldest->fence)) {
+         fprintf(stderr, "radv/wddm2: BC-250 CONCAT RECUSA: espera da fence do slot seq=%" PRIu64
+                         " falhou -- o IB NAO sera reescrito\n", oldest->seq);
+         return NULL;
+      }
+      oldest->seq = 0;
+      oldest->fence_known = false;
+      slot = oldest;
+      if (slot->bo && slot->size_dw >= need_dw)
+         return slot;
+   }
+
+   /* 5. (Re)aloca com as mesmas flags dos BOs de IB do winsys comum. */
+   radv_wddm2_bc250_concat_slot_free_bo(ws, slot);
+   {
+      struct radeon_info *info = ws->base.query_info(&ws->base);
+      const uint32_t align_bytes = MAX2(info->ip[ip].ib_alignment, 4096u);
+      uint64_t size = MAX2((uint64_t)need_dw * 4u + 64u, 64u * 1024u);
+      const enum radeon_bo_flag flags = RADEON_FLAG_CPU_ACCESS | RADEON_FLAG_NO_INTERPROCESS_SHARING |
+                                        RADEON_FLAG_READ_ONLY | RADEON_FLAG_GL2_BYPASS | RADEON_FLAG_GTT_WC;
+      size = align64(size, align_bytes);
+      VkResult result = ws->base.buffer_create(&ws->base, size, align_bytes, ws->base.cs_domain(&ws->base),
+                                               flags, RADV_BO_PRIORITY_CS, 0, NULL, &slot->bo);
+      if (result != VK_SUCCESS || !slot->bo) {
+         slot->bo = NULL;
+         fprintf(stderr, "radv/wddm2: BC-250 CONCAT RECUSA: buffer_create de %" PRIu64 " bytes falhou (%d)\n",
+                 size, (int)result);
+         return NULL;
+      }
+      slot->map = (uint32_t *)radv_buffer_map(&ws->base, slot->bo);
+      if (!slot->map) {
+         radv_wddm2_bc250_concat_slot_free_bo(ws, slot);
+         fprintf(stderr, "radv/wddm2: BC-250 CONCAT RECUSA: map do BO de concatenacao falhou\n");
+         return NULL;
+      }
+      slot->size_dw = (uint32_t)(size / 4u);
+   }
+   return slot;
+}
+
+static void
+radv_wddm2_bc250_concat_release_all(struct radv_wddm2_ctx *ctx)
+{
+   for (uint32_t ip = 0; ip < AMD_NUM_IP_TYPES; ip++) {
+      struct radv_wddm2_bc250_concat_slot *slots = ctx->per_ip[ip].concat;
+      if (!ctx->per_ip[ip].concat_count)
+         continue;
+      /* Um BO que a GPU ainda le nao pode ser destruido: espera a ultima fence. */
+      if (ctx->per_ip[ip].last_submission.handle)
+         (void)vk_wddm2_fence_wait(ctx->ws->device_h, &ctx->per_ip[ip].last_submission);
+      for (uint32_t i = 0; i < ctx->per_ip[ip].concat_count; i++)
+         radv_wddm2_bc250_concat_slot_free_bo(ctx->ws, &slots[i]);
+      ctx->per_ip[ip].concat_count = 0;
+   }
+}
