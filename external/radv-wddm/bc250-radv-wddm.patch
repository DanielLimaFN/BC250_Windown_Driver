+
+__declspec(dllexport) VkResult VKAPI_CALL
+radv_bc250_present_scanout(
+   VkDevice _device,
+   VkQueue _queue,
+   VkDeviceMemory _memory,
+   uint32_t width,
+   uint32_t height)
+{
+   VK_FROM_HANDLE(radv_device, device, _device);
+   VK_FROM_HANDLE(radv_queue, queue, _queue);
+   VK_FROM_HANDLE(radv_device_memory, memory, _memory);
+
+   if (!device || !memory || !memory->bo) {
+      fprintf(stderr, "[RADV_BC250_PRESENT] Invalid parameters: dev=%p mem=%p\n",
+              (void *)device, (void *)memory);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   /* Sincronização obrigatória: assegurar que o compute shader e o blit de destiling
+    * (wsi_cmd_blit_image_to_buffer) foram completamente concluídos pela GPU antes de
+    * disparar o SDMA Blt de apresentação para o scanout da VRAM */
+   if (device->vk.dispatch_table.DeviceWaitIdle) {
+      device->vk.dispatch_table.DeviceWaitIdle(_device);
+   }
+
+   struct radv_wddm2_winsys *ws = radv_wddm2_winsys(device->ws);
+   struct radv_wddm2_bo *bo = radv_wddm2_bo(memory->bo);
+   struct radv_wddm2_ctx *ctx = queue ? (struct radv_wddm2_ctx *)queue->hw_ctx : NULL;
+
+   if (!ws || !bo) {
+      fprintf(stderr, "[RADV_BC250_PRESENT] Invalid winsys or bo\n");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   HMODULE gdi = GetModuleHandleA("gdi32.dll");
+   if (!gdi) gdi = LoadLibraryA("gdi32.dll");
+   if (!gdi) {
+      fprintf(stderr, "[RADV_BC250_PRESENT] Failed to load gdi32.dll\n");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+#define BC250_ESCAPE_SIGNATURE              0xBC250000u
+#define BC250_ESCAPE_OP_PRESENT_BLT         (BC250_ESCAPE_SIGNATURE | 0x01u)
+
+#define BC250_PRESENT_BLT_FLAG_NONE         0x00000000u
+#define BC250_PRESENT_BLT_FLAG_SDMA_ONLY    0x00000001u
+#define BC250_PRESENT_BLT_FLAG_HOST_COPY    0x00000002u
+
+#define BC250_PRESENT_BLT_STATUS_SUCCESS    0x00000000u
+
+#pragma pack(push, 8)
+typedef struct _BC250_ESCAPE_PRESENT_BLT {
+   uint32_t Opcode;             /* BC250_ESCAPE_OP_PRESENT_BLT */
+   uint32_t Width;              /* Largura em pixels (ex: 2560) */
+   uint32_t Height;             /* Altura em pixels (ex: 1080) */
+   uint32_t Pitch;              /* Pitch em bytes (ex: 2560 * 4 = 10240) */
+   uint32_t SizeBytes;          /* Total de bytes (ex: 11059200) */
+   uint32_t SourceAllocation;   /* Handle da alocação (D3DKMT_HANDLE) ou 0 */
+   uint64_t SourceGpuVa;        /* Endereço Virtual GPU (GPUVA) ou 0 */
+   uint64_t SourcePhysAddress;  /* Endereço Físico VRAM (offset local) ou 0 */
+   uint32_t Flags;              /* BC250_PRESENT_BLT_FLAG_* */
+   uint32_t ResultCode;         /* Código de retorno preenchido pelo KMD */
+   void    *pUserPixelBuffer;   /* Ponteiro de memória host-visible mapeada em user-mode */
+   uint64_t Reserved;           /* Alinhamento / expansão futura */
+} BC250_ESCAPE_PRESENT_BLT;
+#pragma pack(pop)
+
+   typedef NTSTATUS (APIENTRY *PFN_D3DKMTEscape)(CONST D3DKMT_ESCAPE *);
+   PFN_D3DKMTEscape pfnEscape = (PFN_D3DKMTEscape)(void *)GetProcAddress(gdi, "D3DKMTEscape");
+   if (pfnEscape) {
+      BC250_ESCAPE_PRESENT_BLT escBlt = {0};
+      escBlt.Opcode = BC250_ESCAPE_OP_PRESENT_BLT;
+      escBlt.Width = width ? width : 2560;
+      escBlt.Height = height ? height : 1080;
+      escBlt.Pitch = escBlt.Width * 4;
+      escBlt.SizeBytes = escBlt.Pitch * escBlt.Height;
+      escBlt.SourceAllocation = bo->base.handle;
+      escBlt.SourceGpuVa = bo->base.va;
+      escBlt.pUserPixelBuffer = bo->map;
+      escBlt.Flags = BC250_PRESENT_BLT_FLAG_NONE;
+
+      static uint32_t s_present_call_count = 0;
+      s_present_call_count++;
+      bool should_log = (s_present_call_count == 1 || (s_present_call_count % 60) == 0);
+
+      D3DKMT_ESCAPE esc = {0};
+      esc.hAdapter = ws->adapter_h;
+      esc.hDevice = ws->device_h;
+      esc.hContext = 0; /* Escape no nivel de adapter/device para desacoplar do ciclo da fila */
+      esc.Type = D3DKMT_ESCAPE_DRIVERPRIVATE;
+      esc.pPrivateDriverData = &escBlt;
+      esc.PrivateDriverDataSize = sizeof(escBlt);
+
+      if (should_log) {
+         fprintf(stderr, "[RADV_BC250_PRESENT #%u] Calling D3DKMTEscape: Opcode=0x%08X Size=%u GpuVa=0x%llX Map=%p\n",
+                 s_present_call_count, escBlt.Opcode, escBlt.SizeBytes, (unsigned long long)escBlt.SourceGpuVa, escBlt.pUserPixelBuffer);
+      }
+
+      NTSTATUS escStatus = pfnEscape(&esc);
+      if (should_log || !NT_SUCCESS(escStatus) || escBlt.ResultCode != BC250_PRESENT_BLT_STATUS_SUCCESS) {
+         fprintf(stderr, "[RADV_BC250_PRESENT #%u] D3DKMTEscape returned NTSTATUS 0x%08X (ResultCode=0x%08X)\n",
+                 s_present_call_count, (unsigned)escStatus, escBlt.ResultCode);
+         fflush(stderr);
+      }
+
+      if (NT_SUCCESS(escStatus) && escBlt.ResultCode == BC250_PRESENT_BLT_STATUS_SUCCESS) {
+         if (should_log) {
+            fprintf(stderr, "[RADV_BC250_PRESENT #%u] Presentation via KMD Escape SUCCEEDED!\n", s_present_call_count);
+            fflush(stderr);
+         }
+         return VK_SUCCESS;
+      }
+      fprintf(stderr, "[RADV_BC250_PRESENT #%u] Escape presentation failed, attempting D3DKMTPresent fallback...\n", s_present_call_count);
+      fflush(stderr);
+   }
+
+   typedef NTSTATUS (APIENTRY *PFN_D3DKMTPresent)(D3DKMT_PRESENT *);
+   PFN_D3DKMTPresent pfnPresent = (PFN_D3DKMTPresent)(void *)GetProcAddress(gdi, "D3DKMTPresent");
+   if (!pfnPresent) {
+      fprintf(stderr, "[RADV_BC250_PRESENT] Failed to resolve D3DKMTPresent in gdi32.dll\n");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   D3DKMT_PRESENT present = {0};
+   if (ctx && ctx->per_ip[AMD_IP_COMPUTE].queue.context_h) {
+      present.hContext = ctx->per_ip[AMD_IP_COMPUTE].queue.context_h;
+   } else if (ctx && ctx->per_ip[AMD_IP_GFX].queue.context_h) {
+      present.hContext = ctx->per_ip[AMD_IP_GFX].queue.context_h;
+   } else {
+      present.hDevice = ws->device_h;
+   }
+
+   present.hSource = bo->base.handle;
+   present.VidPnSourceId = 0;
+   present.Flags.Blt = 1;
+   present.Flags.DstRectValid = 1;
+   present.Flags.SrcRectValid = 1;
+   present.DstRect.left = 0;
+   present.DstRect.top = 0;
+   present.DstRect.right = (LONG)(width ? width : 2560);
+   present.DstRect.bottom = (LONG)(height ? height : 1080);
+   present.SrcRect = present.DstRect;
+
+   fprintf(stderr, "[RADV_BC250_PRESENT] Calling D3DKMTPresent: hCtx=0x%x hDev=0x%x hSource=0x%x rect=(%ld,%ld)-(%ld,%ld)\n",
+           (unsigned)present.hContext, (unsigned)ws->device_h, (unsigned)present.hSource,
+           present.DstRect.left, present.DstRect.top, present.DstRect.right, present.DstRect.bottom);
+   fflush(stderr);
+
+   NTSTATUS status = pfnPresent(&present);
+   fprintf(stderr, "[RADV_BC250_PRESENT] D3DKMTPresent returned NTSTATUS 0x%08X\n", (unsigned)status);
+   fflush(stderr);
+
+   if (!NT_SUCCESS(status)) {
+      return VK_ERROR_DEVICE_LOST;
+   }
+   return VK_SUCCESS;
+}
