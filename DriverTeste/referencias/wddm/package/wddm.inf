;=============================================================================
; AMD BC-250 Native WDDM Display-Only Miniport INF
; Copyright (c) 2026 AMD BC-250 Driver Project
;=============================================================================

[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%ProviderString%
DriverVer=08/21/2026, 1.0.0821.1616
CatalogFile=wddm.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12
bc250wddm_Files_KM = 12

[SourceDisksNames]
1 = %DiskDescription%,,,.

[SourceDisksFiles]
bc250wddm.sys = 1

[Manufacturer]
%ManufacturerName% = AMD, NTamd64

[AMD.NTamd64]
%BC250DeviceName% = bc250wddm_Inst, PCI\VEN_1002&DEV_13FE&SUBSYS_00001022&REV_00
%BC250DeviceName% = bc250wddm_Inst, PCI\VEN_1002&DEV_13FE&SUBSYS_13FE1002&REV_C4
%BC250DeviceName% = bc250wddm_Inst, PCI\VEN_1002&DEV_13FE

[bc250wddm_Inst]
FeatureScore = F0
CopyFiles = bc250wddm_Files_KM
AddReg = bc250wddm_Inst.AddReg

[bc250wddm_Inst.AddReg]
HKR,, VgaCompatible, 0x00010001, 0

; NAO declarar InstalledDisplayDrivers aqui.
;
; Essa chave aponta o driver de modo USUARIO (uma DLL) que o subsistema de
; display deve carregar. Um KMDOD (display-only) nao tem driver de modo
; usuario -- quem apresenta e o proprio dxgkrnl via DxgkDdiPresentDisplayOnly.
; Apontar para "bc250wddm" fazia o subsistema procurar bc250wddm.dll, que
; nao existe, e desistir DEPOIS de todo o bring-up de kernel ter dado certo.
; O INF do sample KMDOD da Microsoft nao define esta chave.

[bc250wddm_Inst.Services]
AddService = bc250v2, 0x00000002, bc250wddm_Service_Inst

[bc250wddm_Service_Inst]
ServiceType = 1
StartType = 3
ErrorControl = 0
LoadOrderGroup = Video
ServiceBinary = %12%\bc250wddm.sys
AddReg = bc250wddm_Service_AddReg

[bc250wddm_Service_AddReg]
; O pacote instala primeiro como KMDOD puro. O bring-up PSP/GCVM/CP toca
; estado global da GPU e so deve ser habilitado explicitamente em bancada.
HKR,, SkipHwBringup, 0x00010001, 0
HKR,, EnableDangerousEscapes, 0x00010001, 1

[bc250wddm_Files_KM]
bc250wddm.sys

[Strings]
ProviderString = "AMD BC-250 Driver Project"
ManufacturerName = "Advanced Micro Devices, Inc."
DiskDescription = "AMD BC-250 WDDM Driver Installation Disk"
BC250DeviceName = "AMD BC-250 Graphics Adapter"
