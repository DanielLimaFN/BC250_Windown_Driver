;=============================================================================
; AMD BC-250 Native WDDM Display-Only Miniport INF
; Copyright (c) 2026 AMD BC-250 Driver Project
;=============================================================================

[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%ProviderString%
DriverVer=08/21/2026, 1.0.0821.1935
CatalogFile=wddm.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13
bc250wddm_Files_KM = 13

[SourceDisksNames]
1 = %DiskDescription%,,,.

[SourceDisksFiles]
bc250wddm.sys = 1

[Manufacturer]
%ManufacturerName% = AMD, NTamd64

[AMD.NTamd64]
%BC250DeviceName% = bc250wddm_Inst, PCI\VEN_1002&DEV_13FE&SUBSYS_00001022&REV_00
%BC250DeviceName% = bc250wddm_Inst, PCI\VEN_1002&DEV_13FE&SUBSYS_13FE1002&REV_C4
%BC250DeviceName% = bc250wddm_Inst, PCI\VEN_1002&DEV_13FE

[bc250wddm_Inst]
FeatureScore = 00
CopyFiles = bc250wddm_Files_KM
AddReg = bc250wddm_AddReg

[bc250wddm_AddReg]
HKR,, "DriverDesc", %REG_SZ%, "AMD BC-250 / Cyan Skillfish"
HKR,, "HardwareInformation.ChipType", %REG_SZ%, "Navi12 (Cyan Skillfish / Oberon)"
HKR,, "HardwareInformation.AdapterString", %REG_SZ%, "AMD BC-250 / Cyan Skillfish"
HKR,, "HardwareInformation.DacType", %REG_SZ%, "Internal DAC (60Hz)"
HKR,, "HardwareInformation.BiosString", %REG_SZ%, "Cyan Skillfish UEFI GOP v5.00 (7nm, 10600M Transistors, 308mm??)"
HKR,, "HardwareInformation.CClock", %REG_DWORD%, 0x0016E360
HKR,, "HardwareInformation.MClock", %REG_DWORD%, 0x001AB3F0
HKR,, "HardwareInformation.MemorySize", %REG_DWORD%, 0x20000000
HKR,, "HardwareInformation.qwMemorySize", %REG_QWORD%, 0x0000000400000000
HKR,, "DedicatedVideoMemory", %REG_DWORD%, 0x20000000
HKR,, "InstalledDisplayDrivers", %REG_MULTI_SZ%, "amdbc250vulkan", "atio6xxx"
HKR,, "UserModeDriverName", %REG_MULTI_SZ%, "amdbc250vulkan.dll"
HKR,, "UserModeDriverName_Wow", %REG_MULTI_SZ%, "amdbc250vulkan32.dll"
HKR,, "GPU_ProcessSize", %REG_SZ%, "7 nm"
HKR,, "GPU_DieSize", %REG_SZ%, "308 mm??"
HKR,, "GPU_Transistors", %REG_SZ%, "10600M"
HKR,, "GPU_MemoryType", %REG_SZ%, "16 GB GDDR6"

[bc250wddm_Inst.Services]
AddService = bc250v2, 0x00000002, bc250v2_Service_Inst

[bc250v2_Service_Inst]
DisplayName = %ServiceName%
ServiceType = 1
StartType = 3
ErrorControl = 1
LoadOrderGroup = Video
ServiceBinary = %13%\bc250wddm.sys

[bc250wddm_Files_KM]
bc250wddm.sys

[Strings]
ProviderString = "AMD BC-250 Driver Project"
ManufacturerName = "Advanced Micro Devices, Inc."
DiskDescription = "AMD BC-250 WDDM Driver Installation Disk"
BC250DeviceName = "AMD BC-250 / Cyan Skillfish"
ServiceName = "AMD BC-250 WDDM Miniport"
REG_SZ = 0x00000000
REG_DWORD = 0x00010001
REG_QWORD = 0x000B0001
REG_MULTI_SZ = 0x00010000
