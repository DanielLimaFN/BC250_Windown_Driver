{
  "name": "bc250-adrenaline",
  "productName": "BC-250 Adrenaline",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicativo Windows de demonstração para a AMD BC-250",
  "main": "desktop.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-packager . BC-250-Adrenaline --platform=win32 --arch=x64 --icon=assets/icon.ico --out=dist --overwrite --ignore=\"^/(dist|tests|artifacts|prepare-package.py|node_modules/.cache)\"",
    "test:ui": "node tests/ui.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.63.0",
    "@scure/base": "^2.4.0",
    "electron": "^44.3.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  }
}
